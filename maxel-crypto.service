[Unit]
Description=Maxel Crypto Binance Futures Signal Scanner
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=root
WorkingDirectory=/opt/maxel-crypto
EnvironmentFile=/opt/maxel-crypto/.env
ExecStart=/opt/maxel-crypto/venv/bin/python /opt/maxel-crypto/bot.py
Restart=always
RestartSec=20
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/maxel-crypto
PrivateTmp=true
[Install]
WantedBy=multi-user.target
